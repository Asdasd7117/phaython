import os
import cv2
import numpy as np
from moviepy.editor import ImageSequenceClip
from gtts import gTTS
from googletrans import Translator
import requests
from bs4 import BeautifulSoup

def translate_text(text, src='ar', dest='en'):
    translator = Translator()
    translation = translator.translate(text, src=src, dest=dest)
    return translation.text

def text_to_speech(text, lang='en'):
    tts = gTTS(text=text, lang=lang)
    tts.save("assets/output.mp3")
    return "assets/output.mp3"

def get_image_urls(query, num_images=5):
    search_url = f"https://www.google.com/search?hl=en&tbm=isch&q={query}"
    response = requests.get(search_url)
    soup = BeautifulSoup(response.text, 'html.parser')
    image_urls = []
    for img in soup.find_all('img', limit=num_images):
        image_urls.append(img['src'])
    return image_urls

def download_images(image_urls, folder="assets"):
    if not os.path.exists(folder):
        os.makedirs(folder)
    for i, url in enumerate(image_urls):
        img_data = requests.get(url).content
        with open(os.path.join(folder, f"image_{i}.jpg"), 'wb') as handler:
            handler.write(img_data)

def create_video_from_images(image_folder, output_video="output.mp4", fps=1):
    images = [os.path.join(image_folder, img) for img in os.listdir(image_folder) if img.endswith(".jpg")]
    clip = ImageSequenceClip(images, fps=fps)
    clip.write_videofile(output_video, codec='libx264')

def main():
    text = "انشييء تطبيق gogle veo 3 الزي تحول النص ل فيديو يعمل بشكل كويس"
    translated_text = translate_text(text)
    audio_file = text_to_speech(translated_text)
    image_urls = get_image_urls("nature")
    download_images(image_urls)
    create_video_from_images("assets")
    os.system(f"ffmpeg -i {audio_file} -i output.mp4 -c:v copy -c:a aac -strict experimental final_output.mp4")

if __name__ == "__main__":
    main()